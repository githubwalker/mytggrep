# Credentials from my.telegram.org
API_ID=<your-api-id>
API_HASH=<your-api-hash>

# Channels to monitor: private channel IDs (with -100 prefix) or @username of public ones
CHANNELS_TO_MONITOR=["-1001580922552", "-1001637966733", "@serbocoin", "-1004372785668"]

# Destination channel ID
MY_DESTINATION=-1004454283173

# Preliminary text filter: quoted substrings, and / or / not, parentheses;
# TRUE - pass every message, FALSE - pass none. Case-insensitive.
# Wrap the whole expression in single quotes.
PRELIMINARY_FILTER='("куплю" or "нужен" or "нужны" or "ищу" or "меняю" or "прода" or "sell" or "buy") and (("rsd" or "dinar" or "динар" or "eur" or "евро" or "€") or ("rub" or "rur" or "рубл" or "р."))'

AI_ENDPOINT = "https://<your-sub-url>.openai.azure.com/"
AI_MODEL_NAME = "<your-model-name>"
AI_DEPLOYMENT = "<your-deployment-name>"

AI_SUBSCRIPTION_KEY = "<your-ai-subscription-key>"
AI_API_VERSION = "<your-api-version>"

# AI filter: a yes/no question to the model about each message that passed PRELIMINARY_FILTER.
# The message is forwarded only if the model answers "yes".
AI_FILTER="return 'yes' when text says that someone wants to : 
   1. exchange/sell their euro's or dinars to rubles. 
   2. buy/exchange rubles for his/her dinars or euros. 
   3. buy xxx amount of rubles 
  that is 'yes' if someone needs rubles and ready to sell their euros or dinars in exchange of rubles (eur or rsd) <--> rub. 
  note that sometimes author says that hi/she wants to buy rubles. this is 'yes' too.
 else return 'no'. That is when someone wants:
  1. to buy/exchanges euros or dinars
  2. some other text unrelated to buying currency 
  examples: 
  1. 'will sell xxx rubes in exchange of you euros or dinars' should return 'no', 
  2. 'will sell xxx dinars for your rubles' should return 'yes' 
  3. 'will sell xxx euros for your rubles' should return 'yes'
  4. 'will buy your xxx rubles' should return 'yes' 
  5. 'will buy xxx rsd' should return 'no'
  6. 'will buy xxx eur' should return 'no'
  7. 'will buy xxx euros or dinars' should return 'no'
"
